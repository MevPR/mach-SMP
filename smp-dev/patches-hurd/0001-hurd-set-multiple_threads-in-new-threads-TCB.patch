From d0195e127602cf60cc6f5da4cdc3c5ad0e27a341 Mon Sep 17 00:00:00 2001
From: Magnus Reimann <magnus.reimann@mailbox.org>
Date: Wed, 25 Nov 2026 19:45:15 +0100
Subject: [PATCH 2/2] hurd: Set multiple_threads in the TCB of new threads

On x86, the catomic_* operations only use the lock prefix when
tcbhead_t.multiple_threads is set in the current thread's TCB.  On the
Hurd only _hurd_tls_init, for the main thread, sets it: the TCB of
threads created by pthread_create comes from _dl_allocate_tls, which
clears it, and _hurd_tls_new left it at 0.  These threads thus ran e.g.
malloc's fastbin compare-and-exchange without lock, which is atomic on
a single processor but not on SMP: a multithreaded program doing
malloc/free on two processors corrupted its fastbins within seconds
("malloc_consolidate(): unaligned fastbin chunk detected", "corrupted
size vs. prev_size in fastbins"), and so did Hurd servers such as
ext2fs.

Set it in _hurd_tls_new.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Magnus Reimann <magnus.reimann@mailbox.org>
---
 sysdeps/mach/hurd/i386/tls.h   | 3 +++
 sysdeps/mach/hurd/x86_64/tls.h | 3 +++
 2 files changed, 6 insertions(+)

diff --git a/sysdeps/mach/hurd/i386/tls.h b/sysdeps/mach/hurd/i386/tls.h
index 403395db..706b6e66 100644
--- a/sysdeps/mach/hurd/i386/tls.h
+++ b/sysdeps/mach/hurd/i386/tls.h
@@ -295,6 +295,9 @@ _hurd_tls_new (thread_t child, tcbhead_t *tcb)
   HURD_TLS_DESC_DECL (desc, tcb);
 
   tcb->tcb = tcb;
+  /* The catomic_* operations only use a lock prefix when this is set,
+     and they run in this new thread while others run too.  */
+  tcb->multiple_threads = 1;
 
   if (HURD_SEL_LDT (sel))
     err = __i386_set_ldt (child, sel, &desc, 1);
diff --git a/sysdeps/mach/hurd/x86_64/tls.h b/sysdeps/mach/hurd/x86_64/tls.h
index 3543e9be..fb10fba3 100644
--- a/sysdeps/mach/hurd/x86_64/tls.h
+++ b/sysdeps/mach/hurd/x86_64/tls.h
@@ -168,6 +168,9 @@ _hurd_tls_new (thread_t child, tcbhead_t *tcb)
   struct i386_fsgs_base_state state;
 
   tcb->tcb = tcb;
+  /* The catomic_* operations only use a lock prefix when this is set,
+     and they run in this new thread while others run too.  */
+  tcb->multiple_threads = 1;
 
   /* Install the TCB address into FS base.  */
   state.fs_base = (uintptr_t) tcb;
