+ * but WITHOUT ANY WARRANTY ; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with the program ; if not, write to the Free Software
+ * Foundation, Inc., 675 Mass Ave, Cambridge, MA 02139, USA.
+ */
+
+/*
+ * Threads on all processors read the uptime clock in a loop and check
+ * that it never goes backwards, as seen from each thread.  The clock is
+ * advanced by the master processor's clock interrupt and interpolated
+ * with the high precision counter in between, so readers on the other
+ * processors race with the update.
+ */
+
+#include <mach/thread_info.h>
+#include <mach/time_value.h>
+
+#include <syscalls.h>
+#include <testlib.h>
+
+#include <mach.user.h>
+#include <mach_host.user.h>
+
+#define NWORKERS	4
+#define READS		20000
+#define MAXCPUS		64
+
+static volatile int done;
+static volatile long backwards, worst_ns, reads_total;
+static volatile unsigned long cpus_seen;
+static int ncpus;
+
+/* See test-smp.c.  */
+static void assign_all_processors_to_default_pset(void)
+{
+  processor_array_t procs;
+  mach_msg_type_number_t nprocs;
+  processor_set_name_t default_name, cur;
+  processor_set_t default_pset;
+  int err;
+
+  err = host_processors(host_priv(), &procs, &nprocs);
+  ASSERT_RET(err, "host_processors");
+  ncpus = nprocs;
+  printf("%d processors\n", nprocs);
+
+  err = processor_set_default(mach_host_self(), &default_name);
+  ASSERT_RET(err, "processor_set_default");
+  err = host_processor_set_priv(host_priv(), default_name, &default_pset);
+  ASSERT_RET(err, "host_processor_set_priv");
+
+  for (int i = 0; i < nprocs; i++)
+    {
+      err = processor_get_assignment(procs[i], &cur);
+      ASSERT_RET(err, "processor_get_assignment");
+      if (cur == default_name)
+        continue;
+      err = processor_assign(procs[i], default_pset, TRUE);
+      ASSERT_RET(err, "processor_assign");
+    }
+}
+
+static void note_cpu(void)
+{
+  struct thread_sched_info info;
+  mach_msg_type_number_t count = THREAD_SCHED_INFO_COUNT;
+  int err;
+
+  err = thread_info(mach_thread_self(), THREAD_SCHED_INFO,
+                    (thread_info_t) &info, &count);
+  ASSERT_RET(err, "thread_info");
+  if (info.last_processor >= 0 && info.last_processor < MAXCPUS)
+    __atomic_or_fetch(&cpus_seen, 1UL << info.last_processor,
+                      __ATOMIC_RELAXED);
+}
+
+static int64_t ns_of(const time_value64_t *t)
+{
+  return t->seconds * 1000000000LL + t->nanoseconds;
+}
+
+static void reader(void *arg)
+{
+  mach_port_t host = mach_host_self();
+  time_value64_t t;
+  int64_t last = 0;
+  int err;
+
+  (void) arg;
+  for (int i = 0; i < READS; i++)
+    {
+      err = host_get_uptime64(host, &t);
+      ASSERT_RET(err, "host_get_uptime64");
+      int64_t now = ns_of(&t);
+      if (now < last)
+        {
+          __atomic_add_fetch(&backwards, 1, __ATOMIC_RELAXED);
+          if (last - now > worst_ns)
+            worst_ns = last - now;
+        }
+      last = now;
+      if (i % 2000 == 0)
+        note_cpu();
+    }
+  __atomic_add_fetch(&reads_total, READS, __ATOMIC_RELAXED);
+  __atomic_add_fetch(&done, 1, __ATOMIC_RELEASE);
+  thread_terminate(mach_thread_self());
+  FAILURE("thread_terminate");
+}
+
+int main(int argc, char *argv[], int envc, char *envp[])
+{
+  int nseen = 0;
+
+  assign_all_processors_to_default_pset();
+
+  for (long i = 0; i < NWORKERS; i++)
+    test_thread_start(mach_task_self(), reader, (void *) i);
+
+  while (__atomic_load_n(&done, __ATOMIC_ACQUIRE) < NWORKERS)
+    msleep(100);
+
+  for (int i = 0; i < MAXCPUS; i++)
+    if (cpus_seen & (1UL << i))
+      nseen++;
+  printf("%ld reads, %ld backward steps, worst %ld ns, readers ran on %d of %d processors (mask %lx)\n",
+         reads_total, backwards, worst_ns, nseen, ncpus, cpus_seen);
+  ASSERT(backwards == 0, "the uptime clock went backwards");
+
+  return 0;
+}
diff --git a/tests/user-qemu.mk b/tests/user-qemu.mk
index 72a60247..4f0cea83 100644
--- a/tests/user-qemu.mk
+++ b/tests/user-qemu.mk
@@ -264,6 +264,7 @@ USER_TESTS := \
 	tests/test-lll \
 	tests/test-heap \
 	tests/test-preempt \
+	tests/test-clock \
 	tests/test-pset
 
 USER_TESTS_CLEAN = $(subst tests/,clean-,$(USER_TESTS))
