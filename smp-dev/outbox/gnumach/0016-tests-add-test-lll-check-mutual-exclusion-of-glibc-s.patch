+ */
+
+/*
+ * Threads on all processors contend for locks built like glibc's
+ * low-level locks on the Hurd (compare-and-swap fast path, exchange and
+ * gsync_wait/gsync_wake slow path), and check inside the critical
+ * section that they are alone in it.  The locks sit in the data
+ * section of the program, which is copy-on-write, like glibc's.
+ */
+
+#include <mach/thread_info.h>
+#include <mach/machine/vm_param.h>
+
+#include <syscalls.h>
+#include <testlib.h>
+
+#include <mach.user.h>
+#include <mach_host.user.h>
+#include <gnumach.user.h>
+
+#define NWORKERS	4
+#define NLOCKS		4
+#define ITERATIONS	100000
+#define MAXCPUS		64
+
+struct cell
+{
+  int lock;
+  int owner;		/* 0 when free, else worker id + 1 */
+  long counter;
+  long pad[5];
+} __attribute__ ((aligned (64)));
+
+/* Initialized, so in .data rather than .bss.  */
+static struct cell cells[NLOCKS] = { [0] = { .counter = 0, .pad = { 1 } } };
+
+static volatile unsigned long cpus_seen;
+static volatile int done;
+static volatile long overlaps, waits;
+static int ncpus;
+
+/* See test-smp.c.  */
+static void assign_all_processors_to_default_pset(void)
+{
+  processor_array_t procs;
+  mach_msg_type_number_t nprocs;
+  processor_set_name_t default_name, cur;
+  processor_set_t default_pset;
+  int err;
+
+  err = host_processors(host_priv(), &procs, &nprocs);
+  ASSERT_RET(err, "host_processors");
+  ncpus = nprocs;
+  printf("%d processors\n", nprocs);
+
+  err = processor_set_default(mach_host_self(), &default_name);
+  ASSERT_RET(err, "processor_set_default");
+  err = host_processor_set_priv(host_priv(), default_name, &default_pset);
+  ASSERT_RET(err, "host_processor_set_priv");
+
+  for (int i = 0; i < nprocs; i++)
+    {
+      err = processor_get_assignment(procs[i], &cur);
+      ASSERT_RET(err, "processor_get_assignment");
+      if (cur == default_name)
+        continue;
+      err = processor_assign(procs[i], default_pset, TRUE);
+      ASSERT_RET(err, "processor_assign");
+    }
+}
+
+static void note_cpu(void)
+{
+  struct thread_sched_info info;
+  mach_msg_type_number_t count = THREAD_SCHED_INFO_COUNT;
+  int err;
+
+  err = thread_info(mach_thread_self(), THREAD_SCHED_INFO,
+                    (thread_info_t) &info, &count);
+  ASSERT_RET(err, "thread_info");
+  if (info.last_processor >= 0 && info.last_processor < MAXCPUS)
+    __atomic_or_fetch(&cpus_seen, 1UL << info.last_processor,
+                      __ATOMIC_RELAXED);
+}
+
+/* As __lll_lock in glibc's mach/lowlevellock.h.  */
+static void lll_lock(int *ptr)
+{
+  int expect = 0;
+
+  if (__atomic_load_n(ptr, __ATOMIC_RELAXED) != 0
+      || ! __atomic_compare_exchange_n(ptr, &expect, 1, 0,
+                                       __ATOMIC_ACQUIRE, __ATOMIC_RELAXED))
+    while (1)
+      {
+        if (__atomic_exchange_n(ptr, 2, __ATOMIC_ACQUIRE) == 0)
+          break;
+        __atomic_add_fetch(&waits, 1, __ATOMIC_RELAXED);
+        gsync_wait(mach_task_self(), (vm_offset_t) ptr, 2, 0, 0, 0);
+      }
+}
+
+/* As __lll_unlock.  */
+static void lll_unlock(int *ptr)
+{
+  if (__atomic_exchange_n(ptr, 0, __ATOMIC_RELEASE) == 2)
+    gsync_wake(mach_task_self(), (vm_offset_t) ptr, 0, 0);
+}
+
+static void worker(void *arg)
+{
+  long id = (long) arg;
+  unsigned r = id * 7919 + 1;
+
+  for (int i = 0; i < ITERATIONS; i++)
+    {
+      r = r * 1103515245 + 12345;
+      struct cell *c = &cells[(r >> 8) % NLOCKS];
+
+      lll_lock(&c->lock);
+      if (c->owner != 0)
+        __atomic_add_fetch(&overlaps, 1, __ATOMIC_RELAXED);
+      c->owner = id + 1;
+      /* Non-atomic read-modify-write, with some delay.  */
+      long v = c->counter;
+      for (int k = 0; k < (int) (r & 15); k++)
+        __asm__ volatile ("" ::: "memory");
+      c->counter = v + 1;
+      if (c->owner != id + 1)
+        __atomic_add_fetch(&overlaps, 1, __ATOMIC_RELAXED);
+      c->owner = 0;
+      lll_unlock(&c->lock);
+
+      if (i % 10000 == 0)
+        note_cpu();
+    }
+  __atomic_add_fetch(&done, 1, __ATOMIC_RELEASE);
+  thread_terminate(mach_thread_self());
+  FAILURE("thread_terminate");
+}
+
+int main(int argc, char *argv[], int envc, char *envp[])
+{
+  long total = 0;
+  int nseen = 0;
+
+  assign_all_processors_to_default_pset();
+
+  for (long i = 0; i < NWORKERS; i++)
+    test_thread_start(mach_task_self(), worker, (void *) i);
+
+  while (__atomic_load_n(&done, __ATOMIC_ACQUIRE) < NWORKERS)
+    msleep(10);
+
+  for (int i = 0; i < NLOCKS; i++)
+    total += cells[i].counter;
+  for (int i = 0; i < MAXCPUS; i++)
+    if (cpus_seen & (1UL << i))
+      nseen++;
+  printf("%ld increments of %d, %ld overlaps, %ld waits, workers ran on %d of %d processors (mask %lx)\n",
+         total, NWORKERS * ITERATIONS, overlaps, waits, nseen, ncpus, cpus_seen);
+  ASSERT(overlaps == 0 && total == NWORKERS * ITERATIONS,
+         "lock did not exclude");
+
+  return 0;
+}
diff --git a/tests/user-qemu.mk b/tests/user-qemu.mk
index 13617ff5..d69eabed 100644
--- a/tests/user-qemu.mk
+++ b/tests/user-qemu.mk
@@ -261,6 +261,7 @@ USER_TESTS := \
 	tests/test-tlb \
 	tests/test-fault \
 	tests/test-brk \
+	tests/test-lll \
 	tests/test-pset
 
 USER_TESTS_CLEAN = $(subst tests/,clean-,$(USER_TESTS))
