From 884aa3ea2e3893965b3dd2b34d649b373a78a8bb Mon Sep 17 00:00:00 2001
From: Magnus Reimann <magnus.reimann@mailbox.org>
Date: Wed, 25 Nov 2026 00:34:57 +0100
Subject: [PATCH gnumach 05/22] machine: release threads held for an empty
 processor set

Threads assigned to, or created in, a processor set without processors
are held until the set gets one.  processor_doaction was meant to
release them when assigning the first processor, but it tested
new_pset->empty after pset_add_processor, which clears it, so the
threads stayed held forever.

Check whether the set was empty before adding the processor.

* kern/machine.c (processor_doaction): Test whether the new processor
set was empty before calling pset_add_processor.
* tests/test-pset.c: New file.
* tests/user-qemu.mk (USER_TESTS): Add tests/test-pset.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 kern/machine.c     |  5 ++-
 tests/test-pset.c  | 97 ++++++++++++++++++++++++++++++++++++++++++++++
 tests/user-qemu.mk |  3 +-
 3 files changed, 103 insertions(+), 2 deletions(-)
 create mode 100644 tests/test-pset.c

diff --git a/kern/machine.c b/kern/machine.c
index f1380367..f3866a1f 100644
--- a/kern/machine.c
+++ b/kern/machine.c
@@ -384,6 +384,7 @@ static void processor_doaction(processor_t processor)
 	thread_t			thread;
 	thread_t			prev_thread = THREAD_NULL;
 	boolean_t			have_pset_ref = FALSE;
+	boolean_t			was_empty;
 #endif	/* MACH_HOST */
 
 	/*
@@ -512,8 +513,10 @@ Restart_pset:
 	    pset_remove_processor(pset, processor);
 	    pset_unlock(pset);
 
+	    /* pset_add_processor clears empty, so look before.  */
+	    was_empty = new_pset->empty;
 	    pset_add_processor(new_pset, processor);
-	    if (new_pset->empty) {
+	    if (was_empty) {
 		/*
 		 *	Set all the threads loose.
 		 *
diff --git a/tests/test-pset.c b/tests/test-pset.c
new file mode 100644
index 00000000..3d14192e
--- /dev/null
+++ b/tests/test-pset.c
@@ -0,0 +1,97 @@
+/*
+ *  Copyright (C) 2026 Free Software Foundation
+ *
