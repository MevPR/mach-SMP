From 1e64abbd0cd36f82efee1186f56156b282cea7f3 Mon Sep 17 00:00:00 2001
From: Magnus Reimann <magnus.reimann@mailbox.org>
Date: Tue, 24 Nov 2026 19:16:14 +0100
Subject: [PATCH gnumach 02/17] x86_64: reject kernel and non-canonical fs/gs
 bases

thread_setstatus(i386_FSGS_BASE_STATE) only warned about a negative
gs_base.  It stored a masked value in the pcb, but for the current
thread it wrote the unmasked value straight into MSR_KGSBASE, and it
did not check fs_base at all.

A negative gs base defeats the swapgs check on kernel entry
(SWAPGS_ENTRY_IF_NEEDED_R12 tests the sign bit of MSR_GSBASE): after
the syscall returns, the next interrupt or trap from user mode does
not swap, and the kernel runs with a %gs chosen by user space, from
which it reads the CPU number and the per-CPU data.  A non-canonical
fs or gs base makes wrmsr raise #GP in the kernel, either immediately
for the current thread, or in load_context the next time another
thread whose state was set is switched to.

Return KERN_INVALID_ARGUMENT unless both bases are below
VM_MAX_USER_ADDRESS, and leave the pcb untouched in that case.

* i386/i386/pcb.c (thread_setstatus) <i386_FSGS_BASE_STATE>: Reject
fs_base or gs_base at or above VM_MAX_USER_ADDRESS.  Store gs_base
unmasked.
* tests/test-threads.c (set_fsgs_base_expect_invalid)
(test_fsgs_base_invalid): New functions.
(main): Call test_fsgs_base_invalid.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 i386/i386/pcb.c      | 13 +++++++--
 tests/test-threads.c | 69 ++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 79 insertions(+), 3 deletions(-)

diff --git a/i386/i386/pcb.c b/i386/i386/pcb.c
index 7573322a..7c0a675d 100644
--- a/i386/i386/pcb.c
+++ b/i386/i386/pcb.c
@@ -710,10 +710,17 @@ kern_return_t thread_setstatus(
                             return KERN_INVALID_ARGUMENT;
 
                     state = (struct i386_fsgs_base_state *) tstate;
-                    if (state->gs_base & 0x8000000000000000UL)
-                            printf("WARNING: negative gs base not allowed\n");
+                    /*
+                     * Only accept user addresses: a non-canonical base
+                     * makes wrmsr fault in the kernel, and a negative
+                     * gs base would defeat the swapgs check on kernel
+                     * entry (see SWAPGS_ENTRY_IF_NEEDED_R12).
+                     */
+                    if (state->fs_base >= VM_MAX_USER_ADDRESS
+                        || state->gs_base >= VM_MAX_USER_ADDRESS)
+                            return KERN_INVALID_ARGUMENT;
                     thread->pcb->ims.sbs.fsbase = state->fs_base;
-                    thread->pcb->ims.sbs.gsbase = state->gs_base & 0x7fffffffffffffffUL;
+                    thread->pcb->ims.sbs.gsbase = state->gs_base;
                     if (thread == current_thread()) {
                             wrmsr(MSR_REG_FSBASE, state->fs_base);
                             wrmsr(MSR_REG_KGSBASE, state->gs_base);
diff --git a/tests/test-threads.c b/tests/test-threads.c
index 06630bef..c46e6d04 100644
--- a/tests/test-threads.c
+++ b/tests/test-threads.c
@@ -95,10 +95,79 @@ void test_fsgs_base(void)
 #endif
 }
 
+#ifdef __x86_64__
+static void set_fsgs_base_expect_invalid(thread_t thread,
+                                         unsigned long fs_base,
+                                         unsigned long gs_base)
+{
+  struct i386_fsgs_base_state bad;
+  int err;
+
+  bad.fs_base = fs_base;
+  bad.gs_base = gs_base;
+  err = thread_set_state(thread, i386_FSGS_BASE_STATE,
+                         (thread_state_t) &bad, i386_FSGS_BASE_STATE_COUNT);
+  ASSERT(err == KERN_INVALID_ARGUMENT, "invalid fs/gs base accepted\n");
+}
+
+/* Negative, non-canonical, and just past the user address space.  */
+static const unsigned long bad_bases[] = {
+  0xffff800000001000UL, 0x8000000000000000UL, 0x0000800000000000UL,
+};
+#define N_BAD_BASES (sizeof(bad_bases) / sizeof(bad_bases[0]))
+#endif
+
+void test_fsgs_base_invalid(void)
+{
+#ifdef __x86_64__
+  struct i386_fsgs_base_state before, after;
+  mach_msg_type_number_t count;
+  long __seg_fs *fs_ptr = 0;
+  long __seg_gs *gs_ptr = 0;
+  long fs_value = 0x1234, gs_value = 0x5678;
+  thread_t other;
+  int err;
+
+  /* Current thread: rejected values must leave the live bases alone.  */
+  before.fs_base = (unsigned long)&fs_value;
+  before.gs_base = (unsigned long)&gs_value;
+  err = thread_set_state(mach_thread_self(), i386_FSGS_BASE_STATE,
+                         (thread_state_t) &before, i386_FSGS_BASE_STATE_COUNT);
+  ASSERT_RET(err, "thread_set_state");
+  for (int i = 0; i < N_BAD_BASES; i++)
+    {
+      set_fsgs_base_expect_invalid(mach_thread_self(), 0, bad_bases[i]);
+      set_fsgs_base_expect_invalid(mach_thread_self(), bad_bases[i], 0);
+      msleep(10);  /* go through a context switch and some interrupts */
+      ASSERT(*fs_ptr == fs_value, "FS base changed\n");
+      ASSERT(*gs_ptr == gs_value, "GS base changed\n");
+    }
+
+  /* Another thread: rejected values must not reach its pcb.  */
+  other = test_thread_start(mach_task_self(), sleeping_thread, (void*)100);
+  count = i386_FSGS_BASE_STATE_COUNT;
+  err = thread_get_state(other, i386_FSGS_BASE_STATE,
+                         (thread_state_t) &before, &count);
+  ASSERT_RET(err, "thread_get_state");
+  for (int i = 0; i < N_BAD_BASES; i++)
+    {
+      set_fsgs_base_expect_invalid(other, 0, bad_bases[i]);
+      set_fsgs_base_expect_invalid(other, bad_bases[i], 0);
+    }
+  count = i386_FSGS_BASE_STATE_COUNT;
+  err = thread_get_state(other, i386_FSGS_BASE_STATE,
+                         (thread_state_t) &after, &count);
+  ASSERT_RET(err, "thread_get_state");
+  ASSERT(before.fs_base == after.fs_base && before.gs_base == after.gs_base,
+         "fs/gs base of other thread changed\n");
+#endif
+}
+
 
 int main(int argc, char *argv[], int envc, char *envp[])
 {
   test_fsgs_base();
+  test_fsgs_base_invalid();
   test_many();
   return 0;
 }
